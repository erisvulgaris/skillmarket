# SkillCart Environment Variables
# Copy this file to .env and fill in your values

# Required
SESSION_SECRET=replace-with-a-random-64-character-string

# Database (defaults to SQLite at ./db/custom.db)
# DATABASE_URL=file:./db/custom.db

# App URL (used for CORS and links)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# VAPID Keys for Web Push notifications
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_EMAIL=mailto:admin@skillcart.app

# SMTP Mail (for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=password

# Sentry Error Tracking
# SENTRY_DSN=https://example@sentry.io/123

# Bundle Analyzer
# ANALYZE=true
